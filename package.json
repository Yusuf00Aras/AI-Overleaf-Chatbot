{
  "name": "overleaf-chat-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local AI chat studio and WebSocket/TCP MCP gateway for Overleaf",
  "engines": { "node": ">=22.21" },
  "scripts": {
    "dev": "concurrently -k \"tsx watch --use-env-proxy server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --use-env-proxy server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "live": "tsx scripts/live-session.ts",
    "browser:install": "playwright install chromium",
    "test": "tsx --test --test-timeout=20000 tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "playwright": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}